<Window x:Class="Hindsight.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hindsight — Oynatıcı" Width="1100" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}" Icon="/Resources/hindsight.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource SidebarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- Video -->
        <Grid Grid.Row="1" Background="Black" MouseLeftButtonUp="OnVideoClick">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" Stretch="Uniform" />
            <Border x:Name="PausedOverlay" Width="76" Height="76" CornerRadius="38" Background="#99000000" IsHitTestVisible="False">
                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="30" Foreground="White" Margin="4,0,0,0" />
            </Border>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="460"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="13.5" />
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="16" Foreground="{StaticResource TextBrush}"
                            Click="OnPlayPause" ToolTip="Oynat / duraklat (Boşluk)" />
                    <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="8,0,14,0"
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" />
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Canvas x:Name="TrimLayer" Height="4" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
                            <Rectangle x:Name="TrimBand" Height="10" Canvas.Top="-3" Fill="#33FF9F43" RadiusX="3" RadiusY="3" />
                        </Canvas>
                        <Slider x:Name="Seek" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="OnSeekDown" PreviewMouseLeftButtonUp="OnSeekUp"
                                ValueChanged="OnSeekChanged" />
                    </Grid>
                    <TextBlock Grid.Column="3" Text="&#xE767;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" Margin="16,0,8,0" />
                    <Slider x:Name="Volume" Grid.Column="4" Width="90" Minimum="0" Maximum="1" Value="0.8" ValueChanged="OnVolumeChanged" />
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,10,6" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent2Brush}" Margin="2,0,8,0" />
                            <Button Content="Başlangıç (I)" Padding="10,5" Click="OnMarkIn" ToolTip="Kırpmanın başlangıcını şu ana ayarla" />
                            <TextBlock x:Name="InText" Text="0:00" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" />
                            <Button Content="Bitiş (O)" Padding="10,5" Click="OnMarkOut" ToolTip="Kırpmanın bitişini şu ana ayarla" />
                            <TextBlock x:Name="OutText" Text="0:00" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" />
                            <Button x:Name="TrimButton" Content="Kırp ve kaydet" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnTrim" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,10,6" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource InfoBrush}" Margin="2,0,8,0" />
                            <TextBlock Text="Discord için küçült" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,0,8,0" />
                            <Button Content="10 MB" Padding="10,5" Click="OnCompress10" />
                            <Button Content="50 MB" Padding="10,5" Margin="6,0,0,0" Click="OnCompress50" />
                            <Button Content="GIF yap" Padding="10,5" Margin="6,0,0,0" Click="OnGif" ToolTip="Seçili aralıktan (en fazla 15 sn) GIF" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,0,6" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopy" ToolTip="Dosyayı panoya kopyala" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Click="OnShowInFolder" ToolTip="Klasörde göster" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDelete" ToolTip="Geri Dönüşüm Kutusu'na taşı" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
