<Window x:Class="Hindsight.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Hindsight.App.Controls"
        Title="Hindsight" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}" Icon="/Resources/hindsight.ico" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:EqualsConverter x:Key="Equals" />
        <c:VisibleWhen x:Key="Visible" />
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:0.9" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="/Resources/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Hindsight" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült" />
            <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Kapat (Hindsight tepside çalışmaya devam eder)" />
        </StackPanel>

        <!-- Sidebar -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,10,12,14">
                <!-- Live status card -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="PulseRing" Width="14" Height="14" Fill="{StaticResource AccentBrush}" Opacity="0" />
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource DimBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="48"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Height="4" Margin="0,10,0,0">
                            <Border Background="{StaticResource Surface3Brush}" CornerRadius="2" />
                            <Border x:Name="FillBar" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding SaveClipCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="Klip kaydet" />
                                <Border Background="#33FFFFFF" CornerRadius="5" Padding="6,1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SaveHotkey}" FontSize="11" FontWeight="Normal" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="MENÜ" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="14,8,0,8" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Ana sayfa" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=home, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="home" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Oyunlar" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=games, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="games" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE714;" Content="Klipler" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=clips, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="clips" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Ayarlar" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=settings, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
