<Window x:Class="Hindsight.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Hindsight.App.Controls"
        Title="Hindsight" Width="1320" Height="860" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}" Icon="/Resources/hindsight.ico" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:EqualsConverter x:Key="Equals" />
        <c:VisibleWhen x:Key="Visible" />
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Ambient light behind everything (static gradients: no rendering cost). -->
        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2" Fill="{StaticResource AmbientRed}" IsHitTestVisible="False" />
        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2" Fill="{StaticResource AmbientAmber}" IsHitTestVisible="False" />

        <!-- Title bar -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <Image Source="/Resources/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Hindsight" Style="{StaticResource Display}" FontSize="16.5" Margin="11,0,0,0" VerticalAlignment="Center" />
            <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,1" Margin="9,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült" />
            <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Kapat (Hindsight tepside çalışmaya devam eder)" />
        </StackPanel>

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Margin="14,6,14,16">
            <!-- Live card: the replay ring + one big button -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" CornerRadius="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="58" Height="58">
                            <c:BufferRing Fill="{Binding BufferFill}" Head="{Binding RingHead}" IsLive="{Binding IsLive}" StrokeWidth="7" />
                            <TextBlock Text="&#xE7C8;" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="46"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="12,11" HorizontalAlignment="Stretch" Command="{Binding SaveClipCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="Klip kaydet" />
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="6,1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding SaveHotkey}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel>
                <TextBlock Text="MENÜ" Style="{StaticResource Overline}" Margin="12,10,0,10" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Ana sayfa" GroupName="nav"
                             IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=home, Mode=OneWay}"
                             Command="{Binding NavigateCommand}" CommandParameter="home" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Oyunlar" GroupName="nav"
                             IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=games, Mode=OneWay}"
                             Command="{Binding NavigateCommand}" CommandParameter="games" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE714;" Content="Klipler" GroupName="nav"
                             IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=clips, Mode=OneWay}"
                             Command="{Binding NavigateCommand}" CommandParameter="clips" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Ayarlar" GroupName="nav"
                             IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=settings, Mode=OneWay}"
                             Command="{Binding NavigateCommand}" CommandParameter="settings" />
            </StackPanel>
        </DockPanel>

        <!-- Page (its own glass panel, like a sheet laid on the window) -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,10,10" CornerRadius="20" Background="#9C0E0E14"
                BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1" ClipToBounds="True">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </Border>
    </Grid>
</Window>
