<UserControl x:Class="Hindsight.App.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hindsight.App.Controls"
             xmlns:vm="clr-namespace:Hindsight.App.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <c:VisibleWhen x:Key="Visible" />

        <DataTemplate DataType="{x:Type vm:HeaderRow}">
            <StackPanel Orientation="Horizontal" Margin="4,20,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="17" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Bottom" Margin="12,0,0,2" />
            </StackPanel>
        </DataTemplate>

        <ContextMenu x:Key="ClipMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Oynat / aç" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Panoya kopyala (Discord'a yapıştır)" Command="{Binding CopyCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Klasörde göster" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Favorilere ekle / çıkar" Command="{Binding FavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Yeniden adlandır" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Discord için küçült (10 MB)" Command="{Binding Compress10Command}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Küçült (50 MB)" Command="{Binding Compress50Command}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Son 8 saniyeden GIF yap" Command="{Binding MakeGifCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Sil (Geri Dönüşüm Kutusu)" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource ErrorBrush}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="ClipCard" DataType="{x:Type vm:ClipCardViewModel}">
            <Border Width="268" Margin="0,0,16,18" Background="Transparent" Cursor="Hand"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ContextMenu="{StaticResource ClipMenu}" ToolTip="{Binding Title}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid Height="151" x:Name="Thumb">
                        <Border CornerRadius="11" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource DimBrush}" />
                        </Border>
                        <Border CornerRadius="11">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="Hover" CornerRadius="11" Background="#66000000" Opacity="0">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentGradient}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="16" Margin="3,0,0,0" />
                            </Border>
                        </Border>
                        <Border Background="#CC0B0B10" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="11" />
                        </Border>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="30" Height="30" Padding="0"
                                Background="#990B0B10" BorderThickness="0" FontFamily="{StaticResource IconFont}" FontSize="13"
                                Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="Favori">
                            <TextBlock FontFamily="{StaticResource IconFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE734;" />
                                        <Setter Property="Foreground" Value="#CCFFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Border Background="#CC0B0B10" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                            <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="2,9,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClipRow}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ClipCard}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Game filter -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,26,12,12">
                <TextBlock DockPanel.Dock="Top" Text="OYUNA GÖRE" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,6,0,10" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FilterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" Width="18" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="10,0,8,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="26,26,10,0">
            <Grid DockPanel.Dock="Top" Margin="4,0,20,4">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="190">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="32,7,10,7" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Left"
                                   Margin="11,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Sort}"
                              MinWidth="120" Margin="10,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}" ToolTip="Klasörü aç" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Yenile" />
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,12,0,0">
                <RadioButton Style="{StaticResource PillToggle}" Content="Tümü" GroupName="kind" IsChecked="{Binding KindAll}" />
                <RadioButton Style="{StaticResource PillToggle}" Content="Videolar" GroupName="kind" IsChecked="{Binding KindVideos}" />
                <RadioButton Style="{StaticResource PillToggle}" Content="Ekran görüntüleri" GroupName="kind" IsChecked="{Binding KindScreenshots}" />
                <TextBlock Text="Çift tıkla: oynat · Sağ tık: kopyala, küçült, GIF, sil" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="4,24,20,0" Padding="30"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource DimBrush}" />
                    <TextBlock Text="Burada henüz bir şey yok" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="440"
                               Text="Oyun oynarken klip kaydetme kısayoluna bastığında klipler burada, oyun oyun ayrılmış olarak görünür." />
                </StackPanel>
            </Border>

            <ItemsControl Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" Padding="0,0,0,24" Margin="0,4,0,0" SizeChanged="OnListSizeChanged" />
        </DockPanel>
    </Grid>
</UserControl>
