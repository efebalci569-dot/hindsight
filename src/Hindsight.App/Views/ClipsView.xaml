<UserControl x:Class="Hindsight.App.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hindsight.App.Controls"
             xmlns:vm="clr-namespace:Hindsight.App.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <c:VisibleWhen x:Key="Visible" />

        <DataTemplate DataType="{x:Type vm:HeaderRow}">
            <StackPanel Orientation="Horizontal" Margin="4,22,0,13">
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentGlowGradient}" BorderBrush="#40FF7A5A" BorderThickness="1">
                    <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11" Foreground="#FFB4A0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="17.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="12,1,0,0" />
            </StackPanel>
        </DataTemplate>

        <ContextMenu x:Key="ClipMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Oynat / aç" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Panoya kopyala (Discord'a yapıştır)" Command="{Binding CopyCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Klasörde göster" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Favorilere ekle / çıkar" Command="{Binding FavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Yeniden adlandır" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Discord için küçült (10 MB)" Command="{Binding Compress10Command}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Küçült (50 MB)" Command="{Binding Compress50Command}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Son 8 saniyeden GIF yap" Command="{Binding MakeGifCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE8B9;" Style="{StaticResource Icon}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Sil (Geri Dönüşüm Kutusu)" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource ErrorBrush}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="ClipCard" DataType="{x:Type vm:ClipCardViewModel}">
            <Grid x:Name="Card" Width="272" Height="172" Margin="0,0,16,18" Background="Transparent" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  ContextMenu="{StaticResource ClipMenu}" ToolTip="{Binding Title}">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Border CornerRadius="15" Background="{StaticResource Surface2Brush}">
                    <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource DimBrush}" Margin="0,0,0,30" />
                </Border>
                <Border CornerRadius="15">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="15" Background="{StaticResource ShadeGradient}" />
                <Border x:Name="Edge" CornerRadius="15" BorderBrush="#24FFFFFF" BorderThickness="1" />

                <Border x:Name="Play" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,0,28">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF4D5E" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="16" Margin="3,0,0,0" />
                </Border>

                <Border Background="#CC08080C" CornerRadius="7" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="10.5" />
                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Margin="6,0,1,0" />
                    </StackPanel>
                </Border>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Width="30" Height="30" Padding="0"
                        Background="#99080810" BorderThickness="0"
                        Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        ToolTip="Favori">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Text" Value="&#xE734;" />
                                <Setter Property="Foreground" Value="#CCFFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Text" Value="&#xE735;" />
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <StackPanel VerticalAlignment="Bottom" Margin="13,0,13,11">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="#B3FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Play" Property="Opacity" Value="1" />
                    <Setter TargetName="Edge" Property="BorderBrush" Value="#B3FF6A5A" />
                    <Setter TargetName="Card" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClipRow}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ClipCard}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11" Padding="8,7" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Game filter -->
        <Border Margin="12,12,0,12" Style="{StaticResource Card}" Padding="10,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="OYUNA GÖRE" Style="{StaticResource Overline}" Margin="10,2,0,10" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FilterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Surface3Brush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding HasInitials, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                                        <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11" Foreground="#FFB4A0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasInitials, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Medium" Margin="11,0,8,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="26,28,10,0">
            <Grid DockPanel.Dock="Top" Margin="4,0,20,4">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="200">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Left"
                                   Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Sort}"
                              MinWidth="124" Margin="10,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" ToolTip="Klasörü aç" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Yenile" />
                </StackPanel>
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="4,14,20,0">
                <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Tümü" GroupName="kind" IsChecked="{Binding KindAll}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Videolar" GroupName="kind" IsChecked="{Binding KindVideos}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Ekran görüntüleri" GroupName="kind" IsChecked="{Binding KindScreenshots}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Çift tıkla: oynat · Sağ tık: kopyala, küçült, GIF, sil" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="4,24,20,0" Padding="32"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconTile}" Width="54" Height="54" CornerRadius="16">
                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="22" Foreground="#FF8A70" />
                    </Border>
                    <TextBlock Text="Burada henüz bir şey yok" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="440"
                               Text="Oyun oynarken klip kaydetme kısayoluna bastığında klipler burada, oyun oyun ayrılmış olarak görünür." />
                </StackPanel>
            </Border>

            <ItemsControl Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" Padding="0,0,0,24" Margin="0,4,0,0" SizeChanged="OnListSizeChanged" />
        </DockPanel>
    </Grid>
</UserControl>
