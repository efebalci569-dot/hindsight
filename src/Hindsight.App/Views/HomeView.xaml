<UserControl x:Class="Hindsight.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hindsight.App.Controls">
    <UserControl.Resources>
        <c:VisibleWhen x:Key="Visible" />
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Display}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,36" MaxWidth="1240">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ana sayfa" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Son anlar her zaman elinin altında." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenClipsFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Klip klasörü" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- First run -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" BorderBrush="#59FF4D5E" Background="#1AFF4D5E"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="42" Height="42" Background="{StaticResource AccentGradient}" BorderThickness="0">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <TextBlock Text="Hindsight hazır" Style="{StaticResource SectionTitle}" FontSize="16" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" MaxWidth="760" HorizontalAlignment="Left">
                            <Run Text="Arka planda sessizce çalışır: bir oyun açtığında son anları tutmaya başlar, oyun kapanınca durur. Güzel bir an yakaladığında" />
                            <Run Text="{Binding SaveHotkey, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <Run Text="tuşuna bas. Pencereyi kapatınca Hindsight saat yanındaki tepside çalışmaya devam eder." />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ayarlar" Command="{Binding GoToSettingsCommand}" />
                        <Button Content="Anladım" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding DismissWelcomeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero: what is being recorded right now -->
            <Border CornerRadius="22" Height="292" BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                    Background="{StaticResource HeroGradient}">
                <Grid c:RoundedClip.Radius="21">
                    <Image Source="{Binding HeroImage}" Stretch="UniformToFill" Opacity="0.55" Margin="-40" CacheMode="BitmapCache"
                           Visibility="{Binding HeroImage, Converter={StaticResource Visible}}">
                        <Image.Effect>
                            <BlurEffect Radius="34" KernelType="Gaussian" RenderingBias="Performance" />
                        </Image.Effect>
                    </Image>
                    <Border Visibility="{Binding HeroImage, Converter={StaticResource Visible}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F208080C" Offset="0" />
                                <GradientStop Color="#B308080C" Offset="0.55" />
                                <GradientStop Color="#5908080C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="32,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DimBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Main.IsLive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding HeroKicker}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="#E6FFFFFF" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource Display}" FontSize="38" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Main.StatusDetail}" Foreground="#C8FFFFFF" FontSize="14" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <WrapPanel Margin="0,20,0,0">
                                <Border Background="#22FFFFFF" CornerRadius="9" Padding="11,6" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Foreground="#B3FFFFFF" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ProfileText}" FontSize="12.5" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#22FFFFFF" CornerRadius="9" Padding="11,6" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="12" Foreground="#B3FFFFFF" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding EncoderText}" FontSize="12.5" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0" Width="230">
                            <Grid Width="168" Height="168" HorizontalAlignment="Center">
                                <c:BufferRing Fill="{Binding Main.BufferFill}" Head="{Binding Main.RingHead}" IsLive="{Binding Main.IsLive}" StrokeWidth="15" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Display}" FontSize="40" FontWeight="Bold">
                                        <Run Text="{Binding Main.BufferedText, Mode=OneWay}" /><Run Text=" sn" FontSize="15" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="klibe hazır" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource PrimaryButton}" Padding="16,12" FontSize="14.5" Margin="0,18,0,0" Command="{Binding Main.SaveClipCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="13" Foreground="White" Margin="0,0,9,0" />
                                    <TextBlock Text="Klip kaydet" />
                                    <Border Background="#33FFFFFF" CornerRadius="6" Padding="7,1" Margin="11,0,0,0">
                                        <TextBlock Text="{Binding SaveHotkey}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick actions -->
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Button Style="{StaticResource TileButton}" Margin="0,0,10,0" Command="{Binding Main.ToggleRecordingCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="14" Foreground="#FF7A6A" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="13.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Kaydı başlat" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Main.IsManualRecording}" Value="True">
                                                <Setter Property="Text" Value="Kaydı durdur" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Süre sınırı yok" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource KeyChip}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecordHotkey}" Style="{StaticResource KeyText}" />
                        </Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="5,0,5,0" Command="{Binding Main.ScreenshotCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="#2238BDF8" BorderBrush="#4038BDF8">
                            <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14" Foreground="#7DD3FC" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Ekran görüntüsü" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Text="Tam çözünürlük, PNG" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource KeyChip}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScreenshotHotkey}" Style="{StaticResource KeyText}" />
                        </Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="10,0,0,0" Command="{Binding Main.ToggleBufferCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="#2234D399" BorderBrush="#4034D399">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" Foreground="#6EE7B7" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Arka plan kaydı" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Text="Aç / kapat" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource KeyChip}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BufferHotkey}" Style="{StaticResource KeyText}" />
                        </Border>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Stats -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="15" Foreground="#FF8A70" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Klipler" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ClipCountText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="#22FBBF24" BorderBrush="#40FBBF24">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="15" Foreground="#FCD34D" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kullanılan alan" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding StorageText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="#22A78BFA" BorderBrush="#40A78BFA">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Foreground="#C4B5FD" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Oyunlar" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding GameCountText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="#2234D399" BorderBrush="#4034D399">
                            <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="15" Foreground="#6EE7B7" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Bu hafta oynama" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding WeekPlaytimeText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent clips -->
            <Grid Margin="0,30,0,14">
                <TextBlock Text="Son klipler" Style="{StaticResource SectionTitle}" FontSize="18" />
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding GoToClipsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tümünü gör" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasRecent, Converter={StaticResource Visible}, ConverterParameter=invert}" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="16">
                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="20" Foreground="#FF8A70" />
                    </Border>
                    <TextBlock Text="Henüz klip yok" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Bir oyun aç ve" /> <Run Text="{Binding SaveHotkey, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /> <Run Text="tuşuna bas." />
                    </TextBlock>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Recent}" Visibility="{Binding HasRecent, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,14,14" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                Command="{Binding DataContext.OpenClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Card" Height="150" RenderTransformOrigin="0.5,0.5">
                                        <Border CornerRadius="14" Background="{StaticResource Surface2Brush}">
                                            <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource DimBrush}" />
                                        </Border>
                                        <Border CornerRadius="14">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="14" Background="{StaticResource ShadeGradient}" />
                                        <Border x:Name="Edge" CornerRadius="14" BorderBrush="#26FFFFFF" BorderThickness="1" />
                                        <Border Background="#CC08080C" CornerRadius="7" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9">
                                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,11">
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="#B3FFFFFF" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Edge" Property="BorderBrush" Value="#99FF6A5A" />
                                            <Setter TargetName="Card" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Resources -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,9,0" />
                            <TextBlock Text="Kaynak kullanımı" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="17"
                                   Text="Görüntü ekran kartında işlenir, son anlar diskte döner — klip süresini uzatsan da RAM artmaz." />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hindsight" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding AppMemoryText}" Style="{StaticResource MetricValue}" FontSize="18" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kayıt motoru RAM" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding RecorderMemoryText}" Style="{StaticResource MetricValue}" FontSize="18" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Kayıt motoru CPU" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding RecorderCpuText}" Style="{StaticResource MetricValue}" FontSize="18" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Disk arabelleği" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding DiskBufferText}" Style="{StaticResource MetricValue}" FontSize="18" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
