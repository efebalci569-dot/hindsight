<UserControl x:Class="Hindsight.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hindsight.App.Controls">
    <UserControl.Resources>
        <c:VisibleWhen x:Key="Visible" />
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,26,34,34" MaxWidth="1240">
            <TextBlock Text="Ana sayfa" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Son anlar her zaman elinin altında." Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <!-- First run -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" BorderBrush="#55FF4D5E" Background="#1AFF4D5E"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hindsight hazır" Style="{StaticResource SectionTitle}" FontSize="16" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left">
                            <Run Text="Arka planda sessizce çalışır: bir oyun açtığında son anları kaydetmeye başlar, oyun kapanınca durur. Güzel bir an yakaladığında" />
                            <Run Text="{Binding SaveHotkey, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <Run Text="tuşuna bas — klip, oyunun klasörüne kaydedilir. Pencereyi kapatınca Hindsight saat yanındaki tepside çalışmaya devam eder." />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Content="Ayarlar" Command="{Binding GoToSettingsCommand}" />
                        <Button Content="Anladım" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding DismissWelcomeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero: live status + actions -->
            <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="26,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ARKA PLAN KAYDI" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Main.StatusTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Main.StatusDetail}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,16,0,0">
                            <Border Background="#1FFFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding ProfileText}" FontSize="12.5" />
                                </StackPanel>
                            </Border>
                            <Border Background="#1FFFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding EncoderText}" FontSize="12.5" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="260" Margin="24,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="18,13" FontSize="14.5" Command="{Binding Main.SaveClipCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock Text="Klip kaydet" />
                                <Border Background="#33FFFFFF" CornerRadius="5" Padding="7,1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding SaveHotkey}" FontSize="11.5" FontWeight="Normal" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Margin="0,0,5,0" Command="{Binding Main.ToggleRecordingCommand}" ToolTip="{Binding RecordHotkey}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Kaydı başlat" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Main.IsManualRecording}" Value="True">
                                                        <Setter Property="Text" Value="Kaydı durdur" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Margin="5,0,0,0" Command="{Binding Main.ScreenshotCommand}" ToolTip="{Binding ScreenshotHotkey}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Görüntü al" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Style="{StaticResource GhostButton}" Margin="0,6,0,0" Command="{Binding Main.ToggleBufferCommand}" FontWeight="Normal" FontSize="12.5">
                            <TextBlock>
                                <Run Text="Arka plan kaydını aç / kapat" />
                                <Run Text="{Binding BufferHotkey, Mode=OneWay}" Foreground="{StaticResource DimBrush}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Klipler" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ClipCountText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Kullanılan alan" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding StorageText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Oyunlar" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding GameCountText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Bu hafta oynama" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding WeekPlaytimeText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resources -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Kaynak kullanımı" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Hindsight (arayüz)" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding AppMemoryText}" Style="{StaticResource MetricValue}" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kayıt motoru (RAM)" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding RecorderMemoryText}" Style="{StaticResource MetricValue}" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kayıt motoru (CPU)" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding RecorderCpuText}" Style="{StaticResource MetricValue}" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Disk arabelleği" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding DiskBufferText}" Style="{StaticResource MetricValue}" FontSize="17" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="Görüntü ekran kartında yakalanıp küçültülür ve doğrudan donanım kodlayıcısına gider. Son anlar RAM'de değil, diskte dönen küçük parçalarda tutulur — klip süresini uzatsan da bellek kullanımı artmaz. Pencereyi kapatınca arayüz bellekten tamamen boşaltılır." />
                </StackPanel>
            </Border>

            <!-- Recent clips -->
            <Grid Margin="0,26,0,12">
                <TextBlock Text="Son klipler" Style="{StaticResource SectionTitle}" FontSize="17" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Klasörü aç" Command="{Binding OpenClipsFolderCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Tümünü gör" Command="{Binding GoToClipsCommand}" />
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasRecent, Converter={StaticResource Visible}, ConverterParameter=invert}" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource DimBrush}" />
                    <TextBlock Text="Henüz klip yok" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Bir oyun aç ve" /> <Run Text="{Binding SaveHotkey, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="tuşuna bas." />
                    </TextBlock>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Recent}" Visibility="{Binding HasRecent, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,14" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid>
                                    <Border CornerRadius="10" Background="{StaticResource Surface2Brush}" Height="132">
                                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource DimBrush}" />
                                    </Border>
                                    <Border CornerRadius="10" Height="132">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border Background="#CC0B0B10" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                        <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hotkeys -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Kısayollar" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Klip kaydet" Style="{StaticResource MetricLabel}" />
                            <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SaveHotkey}" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Kayıt başlat / durdur" Style="{StaticResource MetricLabel}" />
                            <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding RecordHotkey}" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ekran görüntüsü" Style="{StaticResource MetricLabel}" />
                            <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ScreenshotHotkey}" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Arka plan kaydı aç / kapat" Style="{StaticResource MetricLabel}" />
                            <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding BufferHotkey}" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
