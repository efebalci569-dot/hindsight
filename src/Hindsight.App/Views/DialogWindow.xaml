<Window x:Class="Hindsight.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hindsight" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="17" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Vazgeç" IsCancel="True" Click="OnCancel" />
                <Button x:Name="OkButton" Content="Tamam" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="8,0,0,0" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
